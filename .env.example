# --- Telegram (заявки с формы записи) ---
# 1. Создайте бота у @BotFather, получите токен.
# 2. Узнайте ID чата: напишите боту, затем откройте
#    https://api.telegram.org/bot<ТОКЕН>/getUpdates (поле chat.id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Сервер ---
PORT=3000
NODE_ENV=production
# Разрешённый origin для API (если фронтенд на другом домене).
# Для одного домена оставьте пустым — CORS будет закрыт.
ORIGIN=

# --- Домен ---
# Единственное место с прод-доменом: из него собираются canonical, og:url,
# robots.txt и sitemap.xml при сборке. Замените после выбора домена.
SITE_URL=https://arqa-kokshetau.kz

# --- Telegram (тестируемость) ---
# Переопределяет URL Telegram Bot API. Оставьте пустым для продакшена.
TELEGRAM_API_URL=

# --- Аналитика (необязательно) ---
# Любой self-hosted Umami: задайте оба значения, и скрипт попадёт в index.html при сборке.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
